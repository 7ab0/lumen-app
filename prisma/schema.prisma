// Esquema de datos de Lumen — Financiera personal
// Ver plan completo en: claude/plan-lumen-app.md (proyecto Lumen)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff / usuarios del sistema (no confundir con Client, que son los clientes
// que reciben préstamos)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COBRADOR
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(COBRADOR)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime @default(now())

  // Recuperación de contraseña
  resetToken          String?  @unique
  resetTokenExpiresAt DateTime?

  clientsCreated      Client[]        @relation("ClientCreatedBy")
  loansCreated        Loan[]          @relation("LoanCreatedBy")
  loansAssigned       Loan[]          @relation("LoanAssignedCollector")
  paymentsRegistered  Payment[]       @relation("PaymentRegisteredBy")
  messagesSent        MessageLog[]    @relation("MessageSentBy")
  attachmentsUploaded Attachment[]    @relation("AttachmentUploadedBy")
  auditLogs           AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Clientes (quienes reciben los préstamos)
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVO
  INACTIVO
}

enum ClientScore {
  A
  B
  C
  D
}

model Client {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  documentId     String       @unique
  phone          String
  email          String?
  address        String?
  declaredIncome Decimal?     @db.Decimal(12, 2)

  // Alta rápida en dos pasos: al crear (paso 1) solo se exigen
  // firstName + lastName + documentId + phone. El resto (address,
  // declaredIncome, guarantors, attachments, referredBy) se completa
  // después desde la ficha del cliente — profileCompletedAt queda null
  // hasta que se guarda el paso 2 al menos una vez.
  profileCompletedAt DateTime?

  referredById   String?
  referredBy     Client?      @relation("ClientReferrals", fields: [referredById], references: [id])
  referrals      Client[]     @relation("ClientReferrals")

  status         ClientStatus @default(ACTIVO)
  score          ClientScore  @default(B)
  scoreUpdatedAt DateTime?

  createdById    String
  createdBy      User         @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  guarantors        Guarantor[]
  loans              Loan[]
  attachments        Attachment[]
  messageLogs        MessageLog[]
  referralsAsReferrer ReferralReward[] @relation("ReferralReferrer")
  referralsAsReferred ReferralReward[] @relation("ReferralReferred")

  @@index([status])
  @@index([score])
  @@map("clients")
}

model Guarantor {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName   String
  documentId String
  phone      String
  address    String?
  createdAt  DateTime @default(now())

  @@map("guarantors")
}

// ---------------------------------------------------------------------------
// Préstamos, cuotas y pagos
// ---------------------------------------------------------------------------

enum PaymentFrequency {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum LoanStatus {
  ACTIVO
  PAGADO
  EN_MORA
  CANCELADO
  REFINANCIADO
}

model Loan {
  id                   String           @id @default(cuid())
  clientId             String
  client               Client           @relation(fields: [clientId], references: [id])
  principalAmount      Decimal          @db.Decimal(12, 2)
  interestRate         Decimal          @db.Decimal(6, 3) // % por periodo de pago
  termMonths           Int
  paymentFrequency     PaymentFrequency @default(MENSUAL)
  startDate            DateTime
  status               LoanStatus       @default(ACTIVO)

  refinancedFromLoanId String?          @unique
  refinancedFromLoan   Loan?            @relation("LoanRefinance", fields: [refinancedFromLoanId], references: [id])
  refinancedInto        Loan?           @relation("LoanRefinance")

  assignedCollectorId  String
  assignedCollector    User             @relation("LoanAssignedCollector", fields: [assignedCollectorId], references: [id])
  createdById          String
  createdBy            User             @relation("LoanCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime         @default(now())

  installments Installment[]
  attachments  Attachment[]
  messageLogs  MessageLog[]

  @@index([status])
  @@index([assignedCollectorId])
  @@map("loans")
}

enum InstallmentStatus {
  PENDIENTE
  PAGADA
  PARCIAL
  ATRASADA
}

model Installment {
  id             String            @id @default(cuid())
  loanId         String
  loan           Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  number         Int
  dueDate        DateTime
  amountDue      Decimal           @db.Decimal(12, 2)
  amountPaid     Decimal           @default(0) @db.Decimal(12, 2)
  lateFee        Decimal           @default(0) @db.Decimal(12, 2)
  status         InstallmentStatus @default(PENDIENTE)
  reminderSentAt DateTime?

  // Queda en true para siempre en cuanto la cuota pasa por ATRASADA al
  // menos una vez, incluso después de pagarse — se usa para calcular el
  // score de puntualidad del cliente (ver lib/score.ts).
  wasLate        Boolean           @default(false)

  payments    Payment[]
  messageLogs MessageLog[]

  @@index([dueDate])
  @@index([status])
  @@unique([loanId, number])
  @@map("installments")
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model Payment {
  id             String        @id @default(cuid())
  installmentId  String
  installment    Installment   @relation(fields: [installmentId], references: [id])
  loanId         String
  loan           Loan          @relation(fields: [loanId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  method         PaymentMethod @default(EFECTIVO)
  registeredById String
  registeredBy   User          @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])
  notes          String?

  // Se registró sin conexión desde la PWA y se sincronizó después.
  // Útil para detectar duplicados/conflictos al reconectar.
  syncedFromOffline Boolean  @default(false)
  offlineClientId   String?  // id generado en el dispositivo antes de sincronizar

  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([installmentId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Referidos (Fase 2)
// ---------------------------------------------------------------------------

enum ReferralStatus {
  PENDIENTE
  PAGADO
}

model ReferralReward {
  id               String         @id @default(cuid())
  referrerClientId String
  referrerClient   Client         @relation("ReferralReferrer", fields: [referrerClientId], references: [id])
  referredClientId String
  referredClient   Client         @relation("ReferralReferred", fields: [referredClientId], references: [id])
  rewardAmount     Decimal        @db.Decimal(12, 2)
  status           ReferralStatus @default(PENDIENTE)
  triggeredByLoanId String?
  createdAt        DateTime       @default(now())

  @@map("referral_rewards")
}

// ---------------------------------------------------------------------------
// Mensajería (WhatsApp), documentos adjuntos y auditoría
// ---------------------------------------------------------------------------

enum MessageChannel {
  WHATSAPP_LINK
  WHATSAPP_API
}

model MessageLog {
  id            String         @id @default(cuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  installmentId String?
  installment   Installment?   @relation(fields: [installmentId], references: [id])
  loanId        String?
  loan          Loan?          @relation(fields: [loanId], references: [id])
  channel       MessageChannel @default(WHATSAPP_LINK)
  messageContent String
  sentAt        DateTime       @default(now())
  sentById      String
  sentBy        User           @relation("MessageSentBy", fields: [sentById], references: [id])

  @@map("message_logs")
}

enum AttachmentRelatedType {
  CLIENT
  LOAN
  PAYMENT
}

enum AttachmentType {
  DNI
  COMPROBANTE_PAGO
  CONTRATO
  OTRO
}

model Attachment {
  id           String                 @id @default(cuid())
  relatedType  AttachmentRelatedType
  relatedId    String

  // Relaciones opcionales según relatedType (para poder hacer joins directos
  // además de guardar relatedId genérico)
  clientId     String?
  client       Client?                @relation(fields: [clientId], references: [id])
  loanId       String?
  loan         Loan?                  @relation(fields: [loanId], references: [id])
  paymentId    String?
  payment      Payment?               @relation(fields: [paymentId], references: [id])

  fileUrl      String
  type         AttachmentType
  uploadedById String
  uploadedBy   User                   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime               @default(now())

  @@index([relatedType, relatedId])
  @@map("attachments")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
